# Copy to .env and fill in real values. Never commit the real .env.
# The app works with none of these set — it falls back to the deterministic
# rule-based provider (services/llm/mock_provider.py) for everything.

# Google AI Studio key (https://aistudio.google.com/api-keys) — powers the
# Gemini-backed conversational composer, /api/v1/generate, and off-topic/
# product-Q&A replies. Unset = rule-based fallback for all of these.
GOOGLE_API_KEY=

# Optional second Gemini key, ideally from a *different* Google Cloud project
# (the free-tier daily request quota is per project, not per process) — when
# the first key hits its daily limit (429), the app automatically retries on
# this one before falling back to the rule-based templates. See
# backend/app/services/llm/gemini_provider.py: MultiKeyGeminiProvider.
# GOOGLE_API_KEY_2=

# Optional: override the default model per routing tier (see
# backend/app/services/llm/router.py for the tier reasoning).
# GEMINI_MODEL_ALPHA=gemini-pro-latest
# GEMINI_MODEL_BETA=gemini-3.5-flash
# GEMINI_MODEL_GAMMA=gemini-3.5-flash-lite

# Hugging Face token (https://huggingface.co/settings/tokens, after
# https://huggingface.co/join) — powers RAG dense embeddings, G1's ML
# injection classifier (ensemble layer on top of the regex patterns),
# sentiment analysis (feeds sales signals), and Arabic->English translation
# (widens BM25 retrieval + off-topic detection for Arabic input). Unset =
# every one of those falls back to its non-ML path (BM25-only retrieval,
# regex-only G1, no sentiment signal, no translation) — nothing breaks.
HUGGINGFACE_API_KEY=

# Optional: override any of the four HF models used.
# HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# HF_INJECTION_MODEL=protectai/deberta-v3-base-prompt-injection-v2
# HF_SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
# HF_TRANSLATION_MODEL=Helsinki-NLP/opus-mt-ar-en

# RAG embeddings stored in LanceDB (rag/.lancedb, rebuild with `python -m rag.ingest`).
# Defaults to Gemini (gemini-embedding-001, 768 dims) when GOOGLE_API_KEY is set,
# otherwise the HF model above. Changing provider/model needs a re-ingest.
# EMBEDDING_PROVIDER=gemini
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Flask session cookie signing key. Any random string in production.
SECRET_KEY=dev-secret-change-me
